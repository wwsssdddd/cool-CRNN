# Text-recognition configuration from the paper (OMR intentionally excluded).
CRNN_DEVICE=cuda
# Значения из официального model/crnn_demo/config.lua.
CRNN_MAX_ITERATIONS=2000000
CRNN_DISPLAY_INTERVAL=100
CRNN_VALIDATION_INTERVAL=1000
CRNN_VALIDATION_SAMPLES=5000
CRNN_SNAPSHOT_INTERVAL=10000
CRNN_BATCH_SIZE=64
CRNN_VAL_BATCH_SIZE=256
CRNN_LR=1.0
CRNN_NUM_WORKERS=4
CRNN_MIN_IMAGE_WIDTH=100
CRNN_TRAIN_IMAGE_WIDTH=100
CRNN_GRAD_CLIP_NORM=0
CRNN_MODELS_PATH=./models/paper-text

# Fill these after datasets are mounted on the server.
CRNN_DATA_PATH=/path/to/synth
CRNN_TRAIN_MANIFEST=/path/to/manifests/synth_train.tsv
CRNN_VAL_MANIFEST=/path/to/manifests/synth_val.tsv
